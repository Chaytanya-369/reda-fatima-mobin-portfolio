# Production URL (no trailing slash). Used for canonical URLs, Open Graph, sitemap and robots.
# Leave unset until the domain is final; the build falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional form backend. Any service that accepts a JSON POST and returns 2xx works
# (e.g. Formspree: https://formspree.io/f/xxxxxxx, Getform, Web3Forms, your own API).
# When unset, the contact form validates input and opens the visitor's email app
# with a pre-filled message to redafatmamobin@gmail.com (mailto fallback).
NEXT_PUBLIC_FORM_ENDPOINT=
